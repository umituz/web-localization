{
  "name": "@umituz/web-localization",
  "version": "1.3.0",
  "description": "Google Translate integrated localization package for web applications",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "type": "module",
  "bin": {
    "web-loc": "dist/scripts/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./setup": "./src/integrations/i18n.setup.ts",
    "./package.json": "./package.json",
    "./react": "./src/react/index.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "node build.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && node dist/scripts/cli.js --version",
    "version:patch": "npm version patch -m 'chore: release v%s'",
    "version:minor": "npm version minor -m 'chore: release v%s'",
    "version:major": "npm version major -m 'chore: release v%s'"
  },
  "keywords": [
    "localization",
    "i18n",
    "google-translate",
    "web"
  ],
  "author": "umituz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/umituz/web-localization"
  },
  "bugs": {
    "url": "https://github.com/umituz/web-localization/issues"
  },
  "homepage": "https://github.com/umituz/web-localization#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "i18next": "^23.0.0 || ^24.0.0 || ^25.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-i18next": "^14.0.0 || ^15.0.0",
    "i18next-browser-languagedetector": "^7.0.0 || ^8.0.0",
    "@umituz/web-seo": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "@umituz/web-seo": "^2.0.15",
    "commander": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "i18next": "^23.11.2",
    "i18next-browser-languagedetector": "^7.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.1",
    "typescript": "^5.4.5",
    "vitest": "^5.0.1"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependenciesMeta": {
    "i18next": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    },
    "i18next-browser-languagedetector": {
      "optional": true
    },
    "@umituz/web-seo": {
      "optional": true
    }
  }
}
